# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` (same folder) and fill in your values.
# Vite only exposes variables that start with VITE_.
# Restart `npm run dev` after any change here.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → anon / public key.
# This key is meant to be public — Row Level Security is what protects
# your data, and it is already configured in supabase/01_schema.sql.
# NEVER put the service_role key in this file.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Storage bucket for food photography (created by supabase/02_storage.sql)
VITE_SUPABASE_IMAGE_BUCKET=menu-images
