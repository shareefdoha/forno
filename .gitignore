# Dead Tailwind CDN bundles left over from the static build — kept on disk,
# excluded from the repo. Nothing references them.
main.css
main.js

node_modules

# The built frontend is kept out of the repo deliberately. It is NOT built on
# the host either — NODE_ENV=production makes npm skip devDependencies, so
# Vite is not installed there. dist/ is built locally and uploaded by hand.
#
# Consequence: after any change under src/, run `npm run build` and upload the
# new dist/ to the server. A git deploy alone will not update the site, and a
# server with no dist/ serves a blank page on every route except /api.
dist
dist-ssr
.env
.env.local
.env.*.local
*.local
.DS_Store
.vite
npm-debug.log*
yarn-error.log*

# Local helper, not part of the project
push-to-github.cmd
set-supabase-key.cmd

# Local database + uploaded photos
server/data/
