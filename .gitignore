# Dead Tailwind CDN bundles left over from the static build — kept on disk,
# excluded from the repo. Nothing references them.
main.css
main.js

node_modules

# dist/ IS committed. The host installs with NODE_ENV=production, which skips
# devDependencies, so Vite isn't available there to build — the built frontend
# ships in the repo instead and server/index.js serves it.
#
# Do not re-add `dist` here. Each build emits new content-hashed filenames
# (index-<hash>.js); if they were ignored, `git add` would silently skip them
# and dist/index.html would point at files that aren't in the repo.
dist-ssr
.env
.env.local
.env.*.local
*.local
.DS_Store
.vite
npm-debug.log*
yarn-error.log*

# Local helper, not part of the project
push-to-github.cmd
set-supabase-key.cmd

# Local database + uploaded photos
server/data/
